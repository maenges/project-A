{
  "name": "ets-fe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "local": "env-cmd -e local vite",
    "dev": "env-cmd -e dev vite",
    "prd": "env-cmd -e prd vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && env-cmd -e dev vite build",
    "build:prd": "tsc && env-cmd -e prd vite build",
    "preview": "vite preview",
    "lint": "yarn run lint:src",
    "lint:src": "eslint --fix src",
    "lint:spec": "eslint --fix \"./src/**/*.spec.{ts,tsx}\"",
    "lint:check": "yarn run lint:src:check && yarn run lint:spec:check",
    "lint:src:check": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"**/*.spec.*\"",
    "lint:spec:check": "eslint \"./src/**/*.spec.{ts,tsx}\"",
    "lint:win": "yarn run lint:src:win && yarn run lint:spec:win",
    "lint:src:win": "eslint --ignore-pattern \"*.spec.*\" --fix \"src\\\\**\\\\*.{ts,tsx}\"",
    "lint:spec:win": "eslint --fix \"src\\\\**\\\\*.spec.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "postinstall": "husky install",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^6.1.8",
    "@mui/material": "^6.1.8",
    "@mui/system": "^6.1.10",
    "@mui/x-date-pickers": "^7.23.0",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@react-pdf-viewer/locales": "^1.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/uuid": "^10.0.0",
    "ag-grid-community": "^32.2.2",
    "ag-grid-react": "^32.2.2",
    "axios": "^1.6.7",
    "ckeditor4-react": "^5.2.1",
    "dayjs": "^1.11.13",
    "env-cmd": "^10.1.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "3.4.120",
    "react": "19.0.0",
    "react-activation": "^0.13.4",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.62.0",
    "react-is": "^18.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.7.1",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.2",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.1.13",
    "styled-reset": "^4.5.2",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.1.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/react-is": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.33.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-sonarjs": "^3.0.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "^3.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^5.4.19"
  },
  "packageManager": "yarn@4.0.2"
}
